{
  "name": "gacela-docs",
  "repository": "git@github.com:gacela-project/gacela.git",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "vitepress": "^1.6.4"
  },
  "scripts": {
    "docs:generate": "node scripts/generate-agent-docs.mjs",
    "predocs:dev": "npm run docs:generate",
    "docs:dev": "vitepress dev docs",
    "predocs:build": "npm run docs:generate",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:check": "npm run docs:generate && node scripts/check-docs.mjs"
  }
